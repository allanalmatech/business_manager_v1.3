# Uploaded files are data, never code.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
php_flag engine off
</IfModule>
<IfModule mod_php7.c>
php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .phps .cgi .pl .py
RemoveType .php .phtml .phar .php3 .php4 .php5 .php7 .phps
<FilesMatch "\.(?i:php\d?|phtml|phar|phps|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>
