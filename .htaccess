Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
RewriteEngine On

# Internal folders are never served
RewriteRule ^(config|includes|migrations|sql|storage|cron|setup|docs|templates|\.git)(/|$) - [F,L,NC]

# Dotfiles, dumps, archives, logs and notes are never served
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(sql|zip|log|md|lock|bak|db)$ - [F,L,NC]
RewriteRule ^(error_log|seed_database\.php)$ - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "same-origin"
</IfModule>
